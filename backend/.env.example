# Conexión a PostgreSQL: base y usuario PROPIOS de Shelfie (no los de otra aplicación).
# Si no existen, `python -m scripts.inicializar_bd` los crea.
DATABASE_URL=postgresql://shelfie:cambiar-esta-clave@localhost:5432/shelfie

PROJECT_NAME=Shelfie Backend API

# desarrollo o produccion. En produccion (o con COOKIE_SECURE=true) el backend no arranca
# si SECRET_KEY es el valor de ejemplo o tiene menos de 32 caracteres.
ENTORNO=desarrollo

# Clave de firma de los tokens de acceso.
# Generar una propia: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:3000

# Sesión de la intranet: duración en horas y cookie solo por HTTPS (true en producción).
SESION_HORAS=12
COOKIE_SECURE=false

# Zona horaria de la biblioteca (vencimientos, calendario y fechas mostradas).
ZONA_HORARIA=America/Caracas

# --- Avisos por correo ---
# archivo: los correos se guardan como .eml en CARPETA_CORREO (para probar sin servidor).
# smtp: se envían con el servidor de abajo. desactivado: quedan en la cola sin enviarse.
CORREO_MODO=archivo
CARPETA_CORREO=correo_saliente
CORREO_REMITENTE=Biblioteca <biblioteca@ejemplo.edu>
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_SEGURIDAD=starttls

# Dirección del frontend que aparece en los enlaces de los correos (recuperar contraseña).
URL_PUBLICA=http://localhost:3000

# Tareas programadas dentro del backend (cola de correos cada 2 minutos y las diarias desde
# HORA_TAREAS). Con varios procesos o un cron propio, ponla en false y usa
# `python -m scripts.tareas`.
TAREAS_AUTOMATICAS=true
HORA_TAREAS=06:00
