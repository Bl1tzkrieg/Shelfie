# Solo para `npm run dev` contra uvicorn en :8000 (copiar a .env.local).
# Es el origen del backend, SIN /api/v1. En la instalación queda sin definir:
# FastAPI sirve la API y el frontend exportado en el mismo origen.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Zona horaria de la biblioteca para mostrar fechas (igual que ZONA_HORARIA del backend).
NEXT_PUBLIC_ZONA_HORARIA=America/Caracas
